generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  fullName String
  userName String
  profession String
  experience String

  age Int
  city String
  stack String
}

model Skills {
  id Int @id @default(autoincrement())
  technology String
  icons String
  status Boolean @default(true)
}

model AboutMe {
  id Int @id @default(autoincrement())
  title String
  desc String
}
model Socials {
  id Int @id @default(autoincrement())
  name String
  link String
  icons String
}